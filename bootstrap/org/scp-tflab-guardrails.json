{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideLabRegions",
      "Effect": "Deny",
      "NotAction": [
        "account:*",
        "billing:*",
        "budgets:*",
        "ce:*",
        "cloudfront:*",
        "cur:*",
        "freetier:*",
        "health:*",
        "iam:*",
        "invoicing:*",
        "notifications:*",
        "organizations:*",
        "payments:*",
        "pricing:*",
        "route53:*",
        "route53domains:*",
        "s3:GetAccountPublicAccessBlock",
        "s3:ListAllMyBuckets",
        "signin:*",
        "sso:*",
        "sts:*",
        "support:*",
        "tax:*",
        "trustedadvisor:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": [
            "ap-southeast-2",
            "ap-southeast-4",
            "us-east-1"
          ]
        }
      }
    },
    {
      "Sid": "DenyExpensiveEc2Types",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringNotLike": {
          "ec2:InstanceType": [
            "t4g.*",
            "m6g.large",
            "m7g.medium",
            "m7g.large"
          ]
        },
        "Null": {
          "ec2:InstanceType": "false"
        }
      }
    },
    {
      "Sid": "DenyExpensiveRdsClasses",
      "Effect": "Deny",
      "Action": [
        "rds:CreateDBInstance",
        "rds:CreateDBInstanceReadReplica",
        "rds:ModifyDBInstance"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "rds:DatabaseClass": [
            "db.t4g.micro",
            "db.t4g.small"
          ]
        },
        "Null": {
          "rds:DatabaseClass": "false"
        }
      }
    },
    {
      "Sid": "DenyCapacityCommitments",
      "Effect": "Deny",
      "Action": [
        "ec2:PurchaseReservedInstancesOffering",
        "ec2:PurchaseCapacityBlock",
        "ec2:CreateCapacityReservation",
        "rds:PurchaseReservedDBInstancesOffering",
        "savingsplans:CreateSavingsPlan"
      ],
      "Resource": "*"
    }
  ]
}
